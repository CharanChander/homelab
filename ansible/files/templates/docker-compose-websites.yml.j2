services:
  cc-it-solutions:
    image: php:apache
    container_name: cc-it-solutions
    volumes:
      - ./cc-it-solutions:/var/www/html
    restart: unless-stopped
    env_file: .env
    healthcheck:
    test: ["CMD", "curl", "-f", "http://localhost"]
    interval: 30s
    timeout: 5s
    retries: 3
    security_opt:
      - no-new-privileges:true
  
  portfolio:
    image: php:apache
    container_name: portfolio
    volumes:
      - ./portfolio:/var/www/html
    restart: unless-stopped
    env_file: .env
    healthcheck:
    test: ["CMD", "curl", "-f", "http://localhost"]
    interval: 30s
    timeout: 5s
    retries: 3
    security_opt:
      - no-new-privileges:true

  portainer-agent:
    image: portainer/agent:latest
    container_name: portainer_websites_agent
    restart: unless-stopped
    ports:
      - "{{ ansible_default_ipv4.address }}:9001:9001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    security_opt:
      - no-new-privileges:true
  
  watchtower:
    image: beatkind/watchtower:latest
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped
    environment:
      - WATCHTOWER_SCHEDULE=0 0 3 * * *
      - WATCHTOWER_CLEANUP=true
    security_opt:
      - no-new-privileges:true

  cloudflare-tunnel-cc-it:
    container_name: tunnel-cc-it
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: ${CLOUDFLARE_TUNNEL_CC_IT}

  cloudflare-tunnel-portfolio:
    container_name: tunnel-portfolio
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: ${CLOUDFLARE_TUNNEL_PORTFOLIO}
    security_opt:
      - no-new-privileges:true
